---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import Badge from "../../components/ui/Badge.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const kindLabel = project.data.kind === "open" ? "开源项目" : "私有项目";
---
<BaseLayout title={`${project.data.title} · ${kindLabel}`} description={project.data.summary}>
  <section class="section" style="padding-top:calc(56px + 64px)">
    <div class="wrap">
      <p class="crumb"><a href="/">{kindLabel === "开源项目" ? "/#open-source" : "/#architecture"} ← 返回</a> / {kindLabel}</p>
      <SectionHead index={project.data.kind === "open" ? "OS" : "PR"} title={project.data.title} />
      <p class="lead">{project.data.tagline}</p>
      <div class="badges" style="margin:16px 0 24px">
        {project.data.tags.map((t) => <Badge>{t}</Badge>)}
      </div>
      {project.data.metrics.length > 0 && (
        <ul class="metrics">
          {project.data.metrics.map((m) => <li>{m}</li>)}
        </ul>
      )}
      <div class="prose body"><Content /></div>
      {project.data.links.length > 0 && (
        <div class="links">
          {project.data.links.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
<style>
  .crumb { font-family: var(--font-mono); font-size: 12px; color: var(--c-muted); margin-bottom: 20px; }
  .crumb a:hover { color: var(--c-accent); }
  .lead { font-size: var(--fs-lead); color: var(--c-text); line-height: 1.5; }
  .metrics { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .metrics li { font-family: var(--font-mono); font-size: 11.5px; color: var(--c-text-2); border: 1px solid var(--c-line-2); padding: 4px 9px; border-radius: var(--radius-sm); }
  .body { margin-top: 28px; max-width: 46em; }
  .body :global(h2) { font-size: 20px; margin: 28px 0 10px; color: var(--c-text); }
  .body :global(p) { color: var(--c-text-2); margin-bottom: 10px; }
  .body :global(li) { color: var(--c-text-2); margin-left: 20px; }
  .body :global(pre) { background: var(--c-bg-2); border: 1px solid var(--c-line); padding: 14px 16px; overflow-x: auto; font-size: 12.5px; line-height: 1.6; margin: 12px 0; }
  .links { display: flex; gap: 12px; margin-top: 32px; }
  .btn { font-family: var(--font-mono); font-size: 13px; padding: 10px 16px; border: 1px solid var(--c-line-2); border-radius: var(--radius-sm); }
  .btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
</style>
