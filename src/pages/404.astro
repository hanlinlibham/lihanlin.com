---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="404 · Hanlin Li">
  <section class="section" style="padding:calc(56px + 96px) 0">
    <div class="wrap">
      <p class="mono" style="color:var(--c-accent);font-size:13px">&lt;404 /&gt;</p>
      <h1 style="font-size:var(--fs-hero);line-height:1.05;margin:12px 0">页面不存在</h1>
      <p style="color:var(--c-text-2)">可能是链接过期了。回到 <a href="/" style="color:var(--c-accent)">首页</a> 或看看 <a href="/daily/" style="color:var(--c-accent)">科技日报</a>。</p>
    </div>
  </section>
</BaseLayout>
