---
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/motion.css";
import { site } from "../site.config";
import Nav from "../components/site/Nav.astro";
import Footer from "../components/site/Footer.astro";
import ProgressBar from "../components/site/ProgressBar.astro";

interface Props { title?: string; description?: string; ogImage?: string; }
const {
  title = `${site.name} · Agent / Harness`,
  description = site.description,
  ogImage = "/og.png",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = {
  "@context": "https://schema.org", "@type": "Person",
  name: site.name, url: "https://lihanlin.com/", email: `mailto:${site.email}`,
  jobTitle: "AI 产品经理", knowsAbout: ["Agent Harness", "上下文工程", "知识编译", "LLM 应用"],
  sameAs: [site.github, site.githubAlt],
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='8' fill='%230b0b0c'/%3E%3Ctext x='32' y='44' font-family='monospace' font-size='30' font-weight='700' fill='%23ff5c00' text-anchor='middle'%3EHLB%3C/text%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="科技日报" href="/daily/feed.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <script>
      import "../scripts/motion";
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <div class="noise" aria-hidden="true"></div>
    <ProgressBar />
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
